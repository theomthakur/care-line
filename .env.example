# Copy to .env.local, or run: lk app env --write --destination .env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which agent answers: booking | screener | mine
AGENT_PROFILE=booking
# Which models: budget | quality   (see src/models.py)
MODEL_PRESET=budget
# Must match "agent_name" in dispatch-rule.json
AGENT_NAME=take2-agent

# Shared private key for the voice adapter and local booking API.
# Generate a unique value and set it in .env.local; never commit the key.
MEMBERGUIDE_AGENT_KEY=
BACKEND_URL=http://127.0.0.1:8000
USE_FAKE_BACKEND=0
