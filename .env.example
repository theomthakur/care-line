# Copy to .env.local, or run: lk app env --write --destination .env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which agent answers: booking | screener | mine
AGENT_PROFILE=booking
# Which models: budget | quality   (see src/models.py)
MODEL_PRESET=budget
# Must match "agent_name" in dispatch-rule.json
AGENT_NAME=take2-agent

# Shared private key for the voice adapter and local booking API.
# Legacy synthetic-loopback-only fallback; production uses scoped key files.
MEMBERGUIDE_AGENT_KEY=
MEMBERGUIDE_ENV=synthetic
MEMBERGUIDE_ORGANIZATION=synthetic
MEMBERGUIDE_AGENT_KEY_FILE=
MEMBERGUIDE_CREDENTIALS_FILE=
# Server-only local console proxy credentials. Never use VITE_* variables.
MEMBERGUIDE_OPERATOR_KEY_FILE=
MEMBERGUIDE_ADMIN_KEY_FILE=
# Mandatory production settings; see docs/BOOKING-SECURITY.md.
MEMBERGUIDE_DB_PATH=
MEMBERGUIDE_IDENTITY_POLICY=
MEMBERGUIDE_RETENTION_POLICY_FILE=
MEMBERGUIDE_STORAGE_EVIDENCE_FILE=
BACKEND_URL=http://127.0.0.1:8000
USE_FAKE_BACKEND=0
